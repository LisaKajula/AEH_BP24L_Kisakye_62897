package pl.pp;

import java.io.*;
import java.util.Scanner;

public class myTwelfthApp {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        File inputFile;

        // Step 1: Get valid input file
        while (true) {
            System.out.print("Enter the path to the input text file: ");
            String inputPath = scanner.nextLine();
            inputFile = new File(inputPath);

            if (inputFile.exists() && inputFile.isFile()) {
                break;
            } else {
                System.out.println("File not found. Please try again.");
            }
        }

        // Step 2: Ask for output file path
        System.out.print("Enter the path for the output file: ");
        String outputPath = scanner.nextLine();

        // Step 3: Read and count lines
        int lineCount = 0;
        try (
            BufferedReader reader = new BufferedReader(new FileReader(inputFile));
            BufferedWriter writer = new BufferedWriter(new FileWriter(outputPath))
        ) {
            while (reader.readLine() != null) {
                lineCount++;
            }

            // Step 4: Display result in console and write to output file
            System.out.println("\n--- Analysis Result ---");
            System.out.println("Total number of lines: " + lineCount);

            writer.write("File analyzed: " + inputFile.getName() + "\n");
            writer.write("Total lines: " + lineCount + "\n");

            System.out.println("Result saved to: " + outputPath);

        } catch (IOException e) {
            System.out.println("Error processing file: " + e.getMessage());
        }
    }
}
